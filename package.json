{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./instrument.ts server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --log-override:empty-import-meta=silent --outfile=dist/server.cjs && esbuild instrument.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/instrument.cjs",
    "start": "node --import ./dist/instrument.cjs dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx src/domain/runAllTests.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.1.14",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "6.2.108",
    "posthog-js": "^1.411.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.13.2",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.0",
    "stripe": "^22.4.0",
    "vite": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
