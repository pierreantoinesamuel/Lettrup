{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --import ./instrument.ts server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --log-override:empty-import-meta=silent --outfile=dist/server.cjs && esbuild instrument.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/instrument.cjs",
    "start": "node --import ./dist/instrument.cjs dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx src/domain/runAllTests.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.31.0",
    "@sentry/node": "^11.9.0",
    "@sentry/react": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cors": "^2.8.6",
    "docx": "^9.15.0",
    "dompurify": "^3.4.13",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.63.0",
    "mammoth": "^1.13.0",
    "motion": "^14.7.1",
    "pdfjs-dist": "6.4.299",
    "posthog-js": "^1.441.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.0",
    "stripe": "^23.0.1",
    "vite": "^8.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/html2pdf.js": "^0.10.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
