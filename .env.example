# =================================================================
# CVPilot Environment Variables Blueprint
# =================================================================

# -----------------------------------------------------------------
# 1. AI ENGINE (Gemini API)
# Primary AI Provider for Interview Simulator, Learning Hub AI Engine,
# Resume Tailoring, Cover Letter Generator, and Career Strategy.
# -----------------------------------------------------------------
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# -----------------------------------------------------------------
# 2. SUPABASE (Database & Authentication)
# Real-time database, user session persistence, and vectors.
# Note: Use public/anon keys here. Do NOT expose service role keys.
# -----------------------------------------------------------------
VITE_SUPABASE_URL=
SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------
# 3. FRANCE TRAVAIL API (Job Search & Offres d'emploi)
# OAuth2 Client Credentials for live France Travail job search.
# Obtain from https://francetravail.io/ (API Offres d'emploi v2).
# -----------------------------------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# -----------------------------------------------------------------
# 4. YOUTUBE DATA API (Learning Hub Video Resources)
# Optional: Used for fetching live YouTube video courses & tutorials.
# -----------------------------------------------------------------
YOUTUBE_API_KEY=
VITE_YOUTUBE_API_KEY=

# -----------------------------------------------------------------
# 5. OPTIONAL AI PROVIDERS (Fallback / Custom Engines)
# -----------------------------------------------------------------
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_API_KEY=

# -----------------------------------------------------------------
# 6. STRIPE (Subscription Billing)
# Server-only — never prefix these with VITE_. Prefer a restricted API key
# (rk_test_.../rk_live_...) scoped to Checkout Sessions, Subscriptions,
# Customers, Prices, and Billing Portal Sessions over a full secret key.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint's signing secret
# (Dashboard, or `stripe listen` in local dev).
# -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------
# 7. SUPABASE SERVICE ROLE (server-only — Stripe webhook writes profiles.plan)
# From Supabase Dashboard > Project Settings > API. Never prefix with VITE_
# and never send this to the browser — profiles.plan and the stripe_* billing
# columns are trigger-protected so only this key can write them.
# -----------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------
# 8. APP & INFRASTRUCTURE SERVICES (Email, Cache, Analytics, Errors)
# -----------------------------------------------------------------
APP_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Pack candidature / budget IA ---
# Key sealing the generated packs (falls back to SUPABASE_SERVICE_ROLE_KEY). Changing it invalidates packs generated before.
APPLICATION_PACK_SECRET=
# Real blended cost of your AI model, in EUR per million tokens (default 10, deliberately pessimistic).
AI_COST_EUR_PER_MTOK=
# Monthly list prices used to size the AI budget (20% of the subscription). Defaults: 9.99 / 39 / 1.99.
PLAN_PRO_PRICE_EUR=
PLAN_MAX_PRICE_EUR=
EXPORT_PACK_PRICE_EUR=

# --- Domaine du site : UN seul réglage pour tout basculer ---
# Front (lu au build) :
VITE_SITE_DOMAIN=
# Serveur (lu au démarrage) :
SITE_DOMAIN=
CANONICAL_HOST=
# Laisser vides = domaine actuel (cvpilot.fr). Mettre lettrup.fr une fois DNS, e-mails et hébergeur prêts.
